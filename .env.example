# Copy to .env before running docker compose up.

# --- PostgreSQL ---
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=meridian
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_PORT=27017
MONGO_DB_NAME=meridian

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql+psycopg2://meridian:meridian@localhost:5432/meridian
MONGO_URL=mongodb://localhost:27017
BACKEND_PORT=8000
SEED_ON_STARTUP=true
DEFAULT_PROPERTY_CAPACITY=20
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- AI Concierge Chatbot ---
# Optional. If empty, the app falls back to local concierge logic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
