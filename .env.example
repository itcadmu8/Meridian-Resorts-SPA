# Copy this file to .env before running the application.
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meridian
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_PORT=27017
MONGO_DB_NAME=Meridian-Resorts

# --- Database URLs ---
# OPTION A: For Docker Compose local databases (Default)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meridian
MONGO_URL=mongodb://mongo:27017

# OPTION B: For Local native development (without Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian
# MONGO_URL=mongodb://localhost:27017

# OPTION C: For Cloud Databases (Neon PostgreSQL + MongoDB Atlas)
# DATABASE_URL=postgresql://user:pass@ep-xyz.aws.neon.tech/meridian-resorts?sslmode=require
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net

# --- Application Configuration ---
BACKEND_PORT=8000
SEED_ON_STARTUP=true
DEFAULT_PROPERTY_CAPACITY=20
CORS_ORIGINS=["*"]

# Optional: Frontend API Base URL (leave blank to auto-detect current hostname)
VITE_API_BASE_URL=

# --- AI Concierge Chatbot (OpenAI) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
