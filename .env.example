# ==============================================================================
# Meridian Resorts & Spa - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env before running locally: cp .env.example .env
# 2. Never commit .env with real secrets to version control!
# 3. For CI/CD, populate these keys in GitHub Repository Settings -> Secrets and Variables.
# ==============================================================================

# --- PostgreSQL (Transactional Database) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=meridian
POSTGRES_PORT=5432

# --- MongoDB (Guest Preferences & Knowledge Base) ---
MONGO_PORT=27017
MONGO_DB_NAME=Meridian-Resorts

# --- Database Connection URLs ---
# OPTION A: For Docker Compose (Local container networking)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meridian
MONGO_URL=mongodb://mongo:27017

# OPTION B: For Local native development (without Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian
# MONGO_URL=mongodb://localhost:27017

# OPTION C: For Cloud Databases (AWS RDS / Neon PostgreSQL + MongoDB Atlas)
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/meridian?sslmode=require
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# --- Application Security & Auth ---
AUTH_SECRET=your_super_secret_jwt_hmac_signing_key_here
CORS_ORIGINS=["*"]

# --- Application Startup Settings ---
BACKEND_PORT=8000
SEED_ON_STARTUP=true
DEFAULT_PROPERTY_CAPACITY=20

# --- Frontend API Base URL ---
# Leave empty to auto-detect browser origin, or specify full backend endpoint:
VITE_API_BASE_URL=http://localhost:8000

# --- AI Concierge Chatbot (OpenAI) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
